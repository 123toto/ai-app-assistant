{
  "name": "@123toto/ai-app-assistant-server",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Framework-neutral Node.js backend for contextual in-app AI assistants",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123toto/ai-app-assistant.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/123toto/ai-app-assistant#readme",
  "bugs": {
    "url": "https://github.com/123toto/ai-app-assistant/issues"
  },
  "keywords": [
    "ai",
    "documentation",
    "assistant",
    "llm",
    "openapi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ai-sdk": ["dist/ai-sdk.d.ts"],
      "express": ["dist/express.d.ts"],
      "nest": ["dist/nest.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "require": "./dist/ai-sdk.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js",
      "require": "./dist/nest.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/ai-sdk.ts src/express.ts src/nest.ts --format esm,cjs --dts --sourcemap --clean --out-dir dist --external ai --external @nestjs/common",
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts src/ai-sdk.ts src/express.ts src/nest.ts --format esm,cjs --dts --sourcemap --out-dir dist --external ai --external @nestjs/common --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@123toto/ai-app-assistant-contracts": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/mistral": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "ai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "~11.1.29",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 <12",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "reflect-metadata": { "optional": true },
    "rxjs": { "optional": true }
  }
}
